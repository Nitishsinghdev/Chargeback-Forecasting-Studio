# Flask
FLASK_ENV=development
FLASK_DEBUG=0
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# Application paths
CHARGEBACK_APP_BASE_DIR=
CHARGEBACK_DATABASE_PATH=

# Forecast defaults
CHARGEBACK_FORECAST_HORIZON=3
CHARGEBACK_CONFIDENCE_LEVEL=0.95
CHARGEBACK_HISTORY_MONTHS=36
CHARGEBACK_MOVING_AVERAGE_WINDOW=3

# Validation
CHARGEBACK_HOLDOUT_MONTHS=3
CHARGEBACK_ROLLING_FOLDS=3
CHARGEBACK_MIN_TRAIN_MONTHS=12
CHARGEBACK_SEASONAL_PERIOD=12

# CSV ingestion
CHARGEBACK_CSV_MAX_ROWS_SAMPLE=10000000
CHARGEBACK_CSV_MAX_FILE_BYTES=262144000
CHARGEBACK_CSV_MIN_DATE_PARSE_RATIO=0.85
CHARGEBACK_CSV_MIN_NUMERIC_RATIO=0.85
CHARGEBACK_REJECTED_SAMPLE_LIMIT=50

# SARIMAX search
CHARGEBACK_SARIMAX_MAX_CANDIDATES=48
CHARGEBACK_SARIMAX_FIT_TIMEOUT=120
CHARGEBACK_SARIMAX_ENFORCE_STATIONARITY=1
CHARGEBACK_SARIMAX_ENFORCE_INVERTIBILITY=1

# Export safety (prefix for formula-injection mitigation)
CHARGEBACK_EXPORT_FORMULA_PREFIX='

# Logging
CHARGEBACK_LOG_LEVEL=INFO
